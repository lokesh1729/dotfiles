zmodload zsh/zprof

# ==========================================
# 1. SYSTEM PATHS & ENVIRONMENT ARCHITECTURE
# ==========================================
export SHELL=/bin/zsh
export PATH=$HOME/.bin:$PATH

# Detect architecture: arm64 = Apple Silicon, x86_64 = Rosetta / Intel
UNAME_MACHINE="$(/usr/bin/uname -m)"
if [[ "${UNAME_MACHINE}" == "arm64" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ "${UNAME_MACHINE}" == "x86_64" ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Additional explicit paths (Apple Silicon hardening)
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# ==========================================
# 2. EARLY NVM GUARD FLAGS (Must sit above plugins)
# ==========================================
export ZSH_NVM_LAZY_LOAD=true
export ZSH_NVM_AUTO_USE=true

# ==========================================
# 3. OH MY ZSH FRAMEWORK CORE CONFIGURATION
# ==========================================
ZSH_THEME="muse"
export ZSH=$HOME/.oh-my-zsh

plugins=(
  git dotenv macos brew celery colorize docker fzf fzf-tab
  gulp iterm2 npm pip pylint python supervisor textmate
  virtualenv vscode yarn zsh-nvm zsh-autosuggestions zsh-syntax-highlighting
)

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
source $ZSH/oh-my-zsh.sh

# ==========================================
# 4. CORE APP ENVIRONMENTS & REPO MANAGEMENT
# ==========================================
export NODE_ENV="development"
export NODE_PORT=5000
export AIRFLOW_HOME=$HOME/work/airflow_workflow
export ACKRC=$HOME/.ackrc
export GIT_SSH=/usr/bin/ssh
export DJANGO_READ_DOT_ENV_FILE=true
export P4CONFIG=".perforce"

# ==========================================
# 5. CORE ENVIRONMENT TOOL INTEGRATIONS (rbenv, jenv, direnv)
# Guarded with command -v so missing tools don't error out
# ==========================================
command -v rbenv  &>/dev/null && eval "$(rbenv init -)"
export PATH="$HOME/.jenv/bin:$PATH"
command -v jenv   &>/dev/null && eval "$(jenv init -)"
# command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# ==========================================
# 6. PYTHON ENVIRONMENT MANAGEMENT (pyenv)
# ==========================================
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv &>/dev/null && eval "$(pyenv init --path)"

