# pgrep_kill: show matching processes, confirm, then kill
# Usage: pgrep_kill <process-name>
pgrep_kill() {
  if [[ -z "$1" ]]; then
    echo "Usage: pgrep_kill <process-name>"
    return 1
  fi

  local name="$1"
  local matches
  matches=$(ps -eo pid,ppid,user,%cpu,%mem,stat,start,command | grep -i "$name" | grep -v grep | grep -v "pgrep_kill")

  if [[ -z "$matches" ]]; then
    echo "No processes found matching: $name"
    return 0
  fi

  echo "\n\033[1mMatching processes:\033[0m"
  echo "  PID   PPID USER             %CPU %MEM STAT STARTED COMMAND"
  echo "$matches"
  echo ""

  local pids
  pids=$(echo "$matches" | awk '{print $1}')
  local pid_count
  pid_count=$(echo "$pids" | wc -l | tr -d ' ')

  echo "\033[33mAbout to kill $pid_count process(es) with SIGKILL (kill -9).\033[0m"
  echo -n "Confirm? [y/N] "
  read -r confirm

  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "$pids" | xargs kill -9 2>/dev/null
    echo "\033[32mKilled $pid_count process(es) matching '$name'.\033[0m"
  else
    echo "Aborted."
  fi
}

