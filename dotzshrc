export PATH="$PATH:/Users/lokesh.sanapalli/Library/Application Support/JetBrains/Toolbox/scripts"
export PATH="$PATH:/usr/local/lib/ruby/gems/2.6.0:/usr/local/Cellar/ruby/2.6.4_2/lib/ruby/gems/2.6.0"

export M2_HOME="/usr/local/opt/maven"

# ==========================================
# 8. COMPILER BUILD FLAGS & RUBY CONFIG
# Deferred into a function — brew is reliably on PATH after oh-my-zsh init above
# ==========================================
_setup_build_flags() {
  local hb sdk_path
  if [[ "$UNAME_MACHINE" == "arm64" ]]; then
    hb="/opt/homebrew/opt"
  else
    hb="/usr/local/opt"
  fi
  sdk_path="$(xcrun --show-sdk-path 2>/dev/null || echo '/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk')"

  export CFLAGS="-I${hb}/openssl/include -I${hb}/bzip2/include -I${hb}/readline/include -I${sdk_path}/usr/include"
  export LDFLAGS="-L${hb}/openssl/lib -L${hb}/readline/lib -L${hb}/zlib/lib -L${hb}/bzip2/lib"
  export CPPFLAGS="-I${hb}/zlib/include -I${hb}/bzip2/include"
  export PKG_CONFIG_PATH="${hb}/zlib/lib/pkgconfig"
  export RUBY_CONFIGURE_OPTS="--with-openssl-dir=${hb}/openssl@1.1"
}
_setup_build_flags

